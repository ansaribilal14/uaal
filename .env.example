# UAAL configuration via environment variables (spec §58).
# Copy to .env and adjust. NEVER commit real credentials.

# --- Storage ---
# UAAL_STATE_DIR=./state
# UAAL_ARTIFACTS_DIR=./artifacts

# --- Timeouts / limits (ms / bytes) ---
# UAAL_ATTEMPT_TIMEOUT_MS=180000
# UAAL_OPERATION_TIMEOUT_MS=300000
# UAAL_MAX_DOWNLOAD_BYTES=2147483648

# --- Behavior ---
# UAAL_LOG_LEVEL=info            # debug | info | warn | error
# UAAL_LEARNING=1                # 0 disables bounded route learning
# UAAL_CACHE=1                   # 0 disables metadata caching
# UAAL_POLITENESS_MS=400         # min ms between requests to the same host

# --- HTTP API ---
# UAAL_HTTP_PORT=7800
# UAAL_API_KEY=change-me         # when set, all /api/* (except /api/health) require Bearer auth

# --- Remote worker (spec §30) ---
# UAAL_COORDINATOR_URL=https://uaal-coordinator.example.com
# UAAL_WORKER_SECRET=generate-a-long-random-secret

# --- Authorized access (spec §28) ---
# Credentials are read from UAAL_CREDENTIAL_* and surfaced to routes that
# declare them. Example for an adapter route that requires credential "apikey":
# UAAL_CREDENTIAL_APIKEY=your-key
